# Copy to .env and fill in. DO NOT commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# Server
PORT=8123

# Auto-enroll engine
# 120s (2 min) matches the tgbot2 reference bot's own AUTO_ENROLL_INTERVAL.
# There is no cap on how many free courses are attempted per run - every
# 100%-off offer the feed finds is enrolled.
AUTO_ENROLL_INTERVAL=120
AUTO_ENROLL_ENABLED=1
FEED_CACHE_TTL=900

# Login rate limiting
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
SESSION_SECURE=0

# Database (MongoDB). Get a URI from MongoDB Atlas.
MONGODB_URI=
MONGODB_DB=udemy_enroller_site

# Google sign-in (optional). Create an OAuth client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
