# Copy to .env and fill in. DO NOT commit .env.
SECRET_KEY=change-me-to-a-long-random-string
SITE_ACCESS_CODE=change-me-access-code

# Server
PORT=8123

# Auto-enroll engine
AUTO_ENROLL_INTERVAL=600
AUTO_ENROLL_ENABLED=1
ENROLL_BATCH_LIMIT=50
FEED_CACHE_TTL=900

# Login rate limiting
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
